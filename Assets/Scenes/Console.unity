  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Instructions:\r\n\r\nPress ESC to immediately stop stimulation.\r\nPress
    UP ARROW to increase stimulation intensity.\r\nPress DOWN ARROW to decrease stimulation
    intensity.\r\nPress LEFT ARROW/RIGHT ARROW to change between min and max.\nPress
    SPACEBAR to test your current stimulation intensity.\r\n\nMin max selection is
    marked by the green bar\nThe Input will selected the source of the stim values
    between the ranges\nThe link button will switch the Stim control from the arrows
    to the input\n\r\nIf not linked, stimulation will only be provided while pressing
    the arrows or the Spacebar. \r\n"
